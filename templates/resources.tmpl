{{- $ops := .Operations -}}
{{- $clientImport := .Var "clientImport" "../../core/http.js" -}}
{{- /* One file per tag: a base "plumbing" client class exposing every
       operation for that resource. */ -}}
{{- range $tag := uniqueTags $ops }}
--- {{ kebabcase $tag }}.gen.ts
// Code generated by openapi-gen; DO NOT EDIT.
import { ApiClient, type CallOptions } from "{{ $clientImport }}";
import type * as models from "./models.gen.js";

/**
 * Low-level "plumbing" client for the {@link https://unikraft.com|Unikraft
 * Cloud} `{{ $tag }}` resource. Methods return the raw response envelope.
 */
export class {{ pascalcase $tag }}Api extends ApiClient {
{{- range $op := $ops }}
{{- if eq (first $op.Operation.Tags) $tag }}
{{ template "method" $op }}
{{- end }}
{{- end }}
}
{{ end }}
--- index.gen.ts
// Code generated by openapi-gen; DO NOT EDIT.
//
// Barrel for the generated "plumbing" API.
export type { ApiClient, CallOptions } from "{{ $clientImport }}";
export * as models from "./models.gen.js";
{{ range $tag := uniqueTags $ops }}export { {{ pascalcase $tag }}Api } from "./{{ kebabcase $tag }}.gen.js";
{{ end }}
{{- define "method" -}}
{{- $op := .Operation -}}
{{- $path := .Path -}}
{{- range pathParameters $op }}{{ $path = replace (printf "{%s}" .Name) (printf "${%s}" (tsSafeName .Name)) $path }}{{ end -}}
{{- $ret := qualifyModels "models" (tsTypeRef (responseJSONSchema $op)) -}}
{{- /* Operations whose response is a server-sent event stream have no JSON
       response body, so they would otherwise be typed `Promise<void>`. Yield
       the event payload instead, streamed via ApiClient.stream(). */ -}}
{{- $sse := false -}}
{{- range $entry := sortedResponseCodes $op.Responses -}}
{{- if and (not $sse) (or (hasPrefix "2" $entry.Code) (eq $entry.Code "default")) -}}
{{- with $entry.Ref -}}{{- with .Value -}}
{{- with index .Content "text/event-stream" -}}{{- $sse = .Schema -}}{{- end -}}
{{- end -}}{{- end -}}
{{- end -}}
{{- end -}}
{{- if and $sse (eq $ret "void") -}}
{{- $ret = qualifyModels "models" (tsTypeRef $sse) -}}
{{- else -}}
{{- $sse = false -}}
{{- end -}}
{{- $bodyRef := requestJSONSchema $op -}}
{{- $bodyReq := requestBodyRequired $op -}}
{{- $query := queryParameters $op -}}
{{- /* The Fetch standard forbids a request body on GET and HEAD, and no JS
       runtime lets us send one. The spec still models filters for those
       operations as a body, but it exposes every one of them as repeatable
       query parameters too (`?uuid=&name=&...`), so the body is deliberately
       dropped here and only the query parameters are emitted. */ -}}
{{- if or (eq .Method "GET") (eq .Method "HEAD") -}}
{{- $bodyRef = false -}}
{{- $bodyReq = false -}}
{{- end -}}
{{- $paramsReq := $bodyReq }}
{{ with $op.Summary }}{{ tsDoc . "  " }}
{{ else }}{{ with $op.Description }}{{ tsDoc . "  " }}
{{ end }}{{ end }}  {{ tsSafeName (camelcase $op.OperationID) }}(
    {{- range pathParameters $op }}
    {{ tsSafeName .Name }}: {{ qualifyModels "models" (paramToTsType .) }},
    {{- end }}
    {{- if or $query $bodyRef }}
    params: {
      {{- range $query }}
      "{{ .Name }}"?: {{ qualifyModels "models" (paramToTsType .) }};
      {{- end }}
      {{- if $bodyRef }}
      body{{ if not $bodyReq }}?{{ end }}: {{ qualifyModels "models" (tsTypeRef $bodyRef) }};
      {{- end }}
    } & CallOptions{{ if not $paramsReq }} = {}{{ end }},
    {{- else }}
    params: CallOptions = {},
    {{- end }}
  ): {{ if $sse }}AsyncGenerator<{{ $ret }}, void, void>{{ else }}Promise<{{ $ret }}>{{ end }} {
    return this.{{ if $sse }}stream{{ else }}request{{ end }}<{{ $ret }}>(
      {
        method: "{{ .Method }}",
        path: `{{ $path }}`,
        {{- if $query }}
        query: {
          {{- range $query }}
          "{{ .Name }}": params["{{ .Name }}"],
          {{- end }}
        },
        {{- end }}
        {{- if $bodyRef }}
        body: params.body,
        {{- end }}
      },
      params,
    );
  }
{{- end -}}
